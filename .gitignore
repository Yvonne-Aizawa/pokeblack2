# Object files
*.nds

# Compilers
# MWCC is proprietary (Metrowerks/Freescale). Acquired from PRET Discord,
# never commit. The whole-tree `/tools/mwccarm/` pattern excludes the
# directory and every file/subdir under it.
tools/mwccarm/**
/tools/mwccarm/

# SDK
# Nitro SDK binaries from PRET Discord. Whole-tree exclusion.
/tools/bin/

# Nitro SDK proprietary source tree (kept locally as reference, never commit).
/tools/NitroSDK-3_2-060901/

# Build folder
build/**
arm*/build/**

# CLion folders
.idea/
cmake-build-debug/

# ROM
*.srl

# Tool executables
*.exe

# Generated files
*.4bpp
*.lz
*.gbapal

# For asmdiff
arm*/baserom.*
arm9/baserom_overlays/
/baserom_files/
*.dump

*.lcf.template

# Working files
arm9/modules/module_*.s
arm9/modules/module_*.sbin
arm9/modules/module_*.cfg

# Dism scripts
/dism.sh
/asmdiff.sh

# Symbols CSV
symbols.csv

# NARCs
*.narc
*.arc
files/**/*.c
*.o
# Per-user build environment activator
setvars.sh
setvars-*.sh

# Nitro SDK proprietary source tree (kept locally as reference, never commit)
tools/NitroSDK-3_2-060901/
